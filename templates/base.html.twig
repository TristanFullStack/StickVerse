<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}StickVerse{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% set navigation_route = app.request.attributes.get('_route')|default('') %}

        <header class="site-header">
            <a class="site-name" href="{{ path('app_home') }}">
                StickVerse
            </a>

            <nav class="site-navigation" aria-label="Navigation principale">
                <a
                    href="{{ path('app_decouvrir') }}"
                    {% if navigation_route == 'app_decouvrir' or navigation_route starts with 'app_wiki' or navigation_route starts with 'app_actualite' or navigation_route in ['app_saison', 'app_collection'] %}aria-current="page"{% endif %}
                >Découvrir</a>
                {% if app.user %}
                    <a
                        href="{{ path('app_hub') }}"
                        {% if navigation_route == 'app_hub' or navigation_route starts with 'app_inventaire' or navigation_route starts with 'app_boutique' or navigation_route starts with 'app_caisse_publique' or navigation_route starts with 'app_equipe' or navigation_route starts with 'app_recompense' or navigation_route starts with 'app_classement' or navigation_route starts with 'app_profil' or navigation_route starts with 'app_combat' or navigation_route starts with 'app_rapport_combat' or navigation_route starts with 'app_objectif_' or navigation_route starts with 'app_mission_' %}aria-current="page"{% endif %}
                    >HUB</a>
                {% endif %}
            </nav>

            <div class="site-account">
                {% if app.user %}
                    <span>{{ app.user.pseudo }}</span>
                    <span data-solde-pieces>{{ app.user.pieces }} pièces</span>
                    <a
                        href="{{ path('app_profil') }}"
                        {% if navigation_route == 'app_profil' %}aria-current="page"{% endif %}
                    >Profil</a>
                    <a href="{{ path('app_logout') }}">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </div>

            {% if is_granted('ROLE_ADMIN') %}
                <nav
                    class="site-admin-navigation"
                    aria-label="Administration"
                    data-navigation-admin
                >
                    <strong class="site-admin-label">Administration</strong>
                    <div class="site-admin-links">
                        <a href="{{ path('app_admin_console') }}" {% if navigation_route == 'app_admin_console' %}aria-current="page"{% endif %}>Console</a>
                        <a href="{{ path('app_stickman_index') }}" {% if navigation_route starts with 'app_stickman_' %}aria-current="page"{% endif %}>Stickmans</a>
                        <a href="{{ path('app_passif_index') }}" {% if navigation_route starts with 'app_passif_' %}aria-current="page"{% endif %}>Passifs</a>
                        <a href="{{ path('app_caisse_index') }}" {% if navigation_route starts with 'app_caisse_' and navigation_route != 'app_caisse_stickman_index' and navigation_route != 'app_caisse_stickman_new' and navigation_route != 'app_caisse_stickman_show' and navigation_route != 'app_caisse_stickman_edit' and navigation_route != 'app_caisse_stickman_delete' %}aria-current="page"{% endif %}>Caisses</a>
                        <a href="{{ path('app_collection_jeu_index') }}" {% if navigation_route starts with 'app_collection_jeu_' %}aria-current="page"{% endif %}>Collections</a>
                        <a href="{{ path('app_caisse_stickman_index') }}" {% if navigation_route starts with 'app_caisse_stickman_' %}aria-current="page"{% endif %}>Contenu des caisses</a>
                        <a href="{{ path('app_actualite_admin_index') }}" {% if navigation_route starts with 'app_actualite_admin_' %}aria-current="page"{% endif %}>Actualités</a>
                        <a href="{{ path('app_admin_recompenses') }}" {% if navigation_route == 'app_admin_recompenses' %}aria-current="page"{% endif %}>Historique récompenses</a>
                    </div>
                </nav>
            {% endif %}
        </header>

        <div class="site-content">
            {% set routes_decouvrir = ['app_wiki', 'app_wiki_show', 'app_actualite_index', 'app_actualite_show', 'app_saison', 'app_collection'] %}
            {% set routes_hub = ['app_inventaire', 'app_boutique', 'app_caisse_publique', 'app_caisse_publique_show', 'app_equipe', 'app_equipe_modifier', 'app_recompenses', 'app_classement', 'app_profil'] %}
            {% set est_route_hub = navigation_route in routes_hub or navigation_route starts with 'app_combat' or navigation_route starts with 'app_rapport_combat' or navigation_route starts with 'app_recompense_' or navigation_route starts with 'app_objectif_' or navigation_route starts with 'app_mission_' %}
            {% if navigation_route in routes_decouvrir %}
                <a class="site-context-back" href="{{ path('app_decouvrir') }}" aria-label="Revenir à la page Découvrir">← Découvrir</a>
            {% elseif est_route_hub %}
                <a class="site-context-back" href="{{ path('app_hub') }}" aria-label="Revenir au HUB joueur">← HUB</a>
            {% endif %}
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
