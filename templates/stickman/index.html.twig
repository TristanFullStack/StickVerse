{% extends 'base.html.twig' %}

{% block title %}Stickman index{% endblock %}

{% block body %}
    <h1>Stickman index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Rarete</th>
                <th>Pv</th>
                <th>Attaque</th>
                <th>Defense</th>
                <th>StatutActif</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for stickman in stickmen %}
            <tr>
                <td>{{ stickman.nom }}</td>
                <td>{{ stickman.rarete }}</td>
                <td>{{ stickman.pv }}</td>
                <td>{{ stickman.attaque }}</td>
                <td>{{ stickman.defense }}</td>
                <td>{{ stickman.statutActif ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_stickman_show', {'id': stickman.id}) }}">show</a>
                    <a href="{{ path('app_stickman_edit', {'id': stickman.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_stickman_new') }}">Create new</a>
{% endblock %}
