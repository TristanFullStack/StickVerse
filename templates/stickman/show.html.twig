{% extends 'base.html.twig' %}

{% block title %}{{ stickman.nom }} - Administration{% endblock %}

{% block body %}
    <div class="admin-page-heading">
        <div><p class="admin-kicker">Administration / Catalogue</p><h1>{{ stickman.nom }}</h1><p>{{ stickman.description }}</p></div>
        <a class="admin-primary-action" href="{{ path('app_stickman_edit', {'id': stickman.id}) }}">Modifier ce Stickman</a>
    </div>
    <section class="admin-detail-card">
        <div class="admin-detail-media">
            <img class="admin-stickman-detail-image" src="{{ asset('images/stickmen/' ~ stickman.image) }}" alt="{{ stickman.nom }}">
            <span class="admin-status {{ stickman.statutActif ? 'admin-status--active' : 'admin-status--inactive' }}">{{ stickman.statutActif ? 'Actif' : 'Inactif' }}</span>
        </div>
        <dl class="admin-detail-list">
            <div><dt>Slug</dt><dd>{{ stickman.slug }}</dd></div>
            <div><dt>Collection</dt><dd>{{ stickman.collectionJeu ? stickman.collectionJeu.nom : 'Non classé' }}</dd></div>
            <div><dt>Rareté</dt><dd>{{ stickman.rarete }}</dd></div>
            <div><dt>PV</dt><dd>{{ stickman.pv }}</dd></div>
            <div><dt>Attaque</dt><dd>{{ stickman.attaque }}</dd></div>
            <div><dt>Défense</dt><dd>{{ stickman.defense }}</dd></div>
        </dl>
    </section>
    <div class="admin-secondary-actions">
        <a href="{{ path('app_stickman_index') }}">← Retour au catalogue</a>
        {{ include('stickman/_delete_form.html.twig') }}
    </div>
{% endblock %}
