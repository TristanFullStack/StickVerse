<article class="stickman-card">
    <h2>{{ stickman.nom }}</h2>

    <img
        class="stickman-card-image"
        src="{{ asset('images/stickmen/' ~ stickman.image) }}"
        alt="{{ stickman.nom }}"
    >

    {% if inventaire is defined and inventaire is not null %}
        <p>
            <strong>Quantité : {{ inventaire.quantite }}</strong>
        </p>
    {% endif %}

    {% if stickman.collectionJeu is defined and stickman.collectionJeu is not null %}
        <p>Collection : {{ stickman.collectionJeu.nom }}</p>
    {% endif %}
    <p>Rareté : {{ stickman.rarete }}</p>
    <p>PV : {{ stickman.pv }}</p>
    <p>Attaque : {{ stickman.attaque }}</p>
    <p>Défense : {{ stickman.defense }}</p>

    <a href="{{ path('app_wiki_show', {'slug': stickman.slug}) }}">
        Voir la fiche
    </a>
</article>
