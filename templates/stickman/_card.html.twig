{% set carteObtenue = possede is defined ? possede : true %}
<a
    class="stickman-card-link{{ carteObtenue ? '' : ' stickman-card-link--non-obtenue' }}"
    href="{{ path('app_wiki_show', {'slug': stickman.slug}) }}"
    aria-label="Voir la fiche de {{ stickman.nom }}"
>
    <article
        class="stickman-card stickman-card--rarete-{{ stickman.rarete|default(1) }}"
        data-rarete="{{ stickman.rarete|default(1) }}"
        data-obtenue="{{ carteObtenue ? 'true' : 'false' }}"
    >
        <h2>{{ stickman.nom }}</h2>

        <img
            class="stickman-card-image"
            src="{{ asset('images/stickmen/' ~ stickman.image) }}"
            alt="{{ stickman.nom }}"
        >

        {% if inventaire is defined and inventaire is not null %}
            <p>
                <strong>Quantité : {{ inventaire.quantite }}</strong>
            </p>
        {% endif %}

        {% if not carteObtenue %}
            <p class="stickman-card-status">Non obtenue</p>
        {% endif %}

        <p>Puissance : <strong>{{ puissance|default('—') }}</strong></p>
        <p>PV : {{ stickman.pv }}</p>
        <p>Attaque : {{ stickman.attaque }}</p>
        <p>Défense : {{ stickman.defense }}</p>

        {% set passifsCarte = stickman.passifs|default([])|slice(0, 6) %}
        <div class="stickman-card-passifs" aria-label="Passifs de la carte">
            {% for passif in passifsCarte %}
                {% set nomPassif = passif.nom|default('Passif') %}
                {% set descriptionPassif = passif.description|default('') %}
                <span
                    class="stickman-card-passif"
                    title="{{ (nomPassif ~ (descriptionPassif ? ' — ' ~ descriptionPassif : ''))|e }}"
                    aria-label="{{ (nomPassif ~ (descriptionPassif ? ' — ' ~ descriptionPassif : ''))|e }}"
                    data-passif-viewer-trigger
                    data-passif-name="{{ nomPassif|e('html_attr') }}"
                    data-passif-description="{{ descriptionPassif|e('html_attr') }}"
                    role="button"
                    tabindex="0"
                    aria-expanded="false"
                >{{ nomPassif|slice(0, 2)|upper }}</span>
            {% endfor %}
        </div>
    </article>
</a>
