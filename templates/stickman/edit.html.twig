{% extends 'base.html.twig' %}

{% block title %}Modifier un Stickman - Administration{% endblock %}

{% block body %}
    <div class="admin-page-heading">
        <div><p class="admin-kicker">Administration / Catalogue</p><h1>Modifier {{ stickman.nom }}</h1><p>Mets à jour les informations et les statistiques de ce Stickman.</p></div>
    </div>
    <section class="admin-form-card">
        {{ include('stickman/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
    </section>
    <div class="admin-secondary-actions">
        <a href="{{ path('app_stickman_index') }}">← Retour au catalogue</a>
        {{ include('stickman/_delete_form.html.twig') }}
    </div>
{% endblock %}
