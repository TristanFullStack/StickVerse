{% extends 'base.html.twig' %}
{% block title %}Actualités — Administration{% endblock %}
{% block body %}<div class="admin-page-heading"><div><p class="admin-kicker">Administration / Communication</p><h1>Actualités</h1><p>Prépare les annonces visibles par les joueurs.</p></div><a class="admin-primary-action" href="{{ path('app_actualite_admin_new') }}">Créer une actualité</a></div><section class="admin-list-panel"><div class="admin-table-scroll"><table class="admin-resource-table"><thead><tr><th>Titre</th><th>Saison</th><th>Publication</th><th>Statut</th><th>Actions</th></tr></thead><tbody>{% for actualite in actualites %}<tr><td><strong>{{ actualite.titre }}</strong><small>{{ actualite.slug }}</small></td><td>{{ actualite.saison ? 'Saison '~actualite.saison.saison : 'Toutes' }}</td><td>{{ actualite.datePublication ? actualite.datePublication|date('d/m/Y H:i') : 'Immédiate' }}</td><td>{{ actualite.statutActif ? 'Publiée' : 'Brouillon' }}</td><td class="admin-table-actions"><a href="{{ path('app_actualite_admin_edit', {id: actualite.id}) }}">Modifier</a><form method="post" action="{{ path('app_actualite_admin_delete', {id: actualite.id}) }}" onsubmit="return confirm('Supprimer cette actualité ?')"><input type="hidden" name="_token" value="{{ csrf_token('delete_actualite_' ~ actualite.id) }}"><button type="submit">Supprimer</button></form></td></tr>{% else %}<tr><td colspan="5">Aucune actualité.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
