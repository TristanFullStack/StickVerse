{% extends 'base.html.twig' %}

{% block title %}StickVerse{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="auth-alert auth-alert--success" role="status">{{ message }}</div>
    {% endfor %}

    <section class="home-hero" aria-labelledby="hero-title">
        <div class="home-hero-copy">
            <span class="page-kicker">Collection · Stratégie · Combat</span>
            <h1 id="hero-title">STICK<span>VERSE</span></h1>
            <p class="hero-description">Collectionne des Stickmans, construis ton équipe et affronte d’autres joueurs.</p>
            <div class="hero-actions">
                <a class="button-primary" href="{{ path(app.user ? 'app_combats_en_ligne' : 'app_register') }}">{{ app.user ? 'JOUER' : 'JOUER GRATUITEMENT' }} <span aria-hidden="true">↗</span></a>
                <a class="hero-secondary" href="{{ path('app_wiki') }}">Découvrir les cartes <span aria-hidden="true">→</span></a>
            </div>
            {% if not app.user %}<p class="starter-gift"><span aria-hidden="true">✦</span> <strong>5 caisses de départ offertes.</strong><br>Découvre tes premières cartes et compose ton équipe.</p>{% else %}<p class="starter-gift">Prêt pour la suite, <strong>{{ app.user.pseudo }}</strong> ? Chaque choix compte.</p>{% endif %}
        </div>
        <div class="home-showcase" aria-label="Un aperçu des vraies cartes StickVerse">
            {% for stickman in vitrine|slice(0, 3) %}
                {% include 'stickman/_card.html.twig' with {stickman: stickman, puissance: puissances[stickman.id]} only %}
            {% else %}<div class="hero-emblem" aria-hidden="true"><img src="{{ asset('images/brand/stickverse.svg') }}" width="200" height="200" alt=""></div>{% endfor %}
        </div>
    </section>
    <section class="game-loop" aria-label="Comment jouer à StickVerse">
        {% for titre, description in {
            'Collectionne': 'Ouvre des caisses et découvre de nouveaux Stickmans.',
            'Construis ton équipe': 'Combine statistiques et passifs. Quatre cartes, ta stratégie.',
            'Combats': 'Affronte d’autres formations. Anticipe les choix adverses.',
            'Progresse': 'Gagne des récompenses et complète tes collections.'
        } %}<article><span class="loop-number">0{{ loop.index }}</span><h2>{{ titre }}</h2><p>{{ description }}</p></article>{% endfor %}
    </section>

    {% if app.user and tableau_de_bord %}
        <h2 class="home-section-title">Ton espace de jeu</h2>

        <p>Bienvenue, {{ app.user.pseudo }}.</p>

        <section class="dashboard-section" aria-labelledby="resume-titre">
            <h2 id="resume-titre">Ta prochaine aventure</h2>

            <div class="dashboard-grid">
                <article class="dashboard-card">
                    <h3>Collection</h3>
                    <p>
                        {{ tableau_de_bord.nombreStickmen }} Stickman(s) différent(s)
                    </p>
                    <a href="{{ path('app_collection') }}">Voir ma collection</a>
                </article>

                <article class="dashboard-card">
                    <h3>Équipe</h3>
                    {% if tableau_de_bord.equipe %}
                        <p>{{ tableau_de_bord.equipe.nom }}</p>
                    {% else %}
                        <p>Aucune équipe enregistrée.</p>
                    {% endif %}
                    <a href="{{ path('app_equipe') }}">Gérer mon équipe</a>
                </article>

                <article class="dashboard-card">
                    <h3>Pièces</h3>
                    <p data-dashboard-pieces>{{ app.user.pieces }} pièces disponibles</p>
                    <a href="{{ path('app_boutique') }}">Visiter la boutique</a>
                </article>

                <article class="dashboard-card">
                    <h3>Saison</h3>
                    {% if saison %}
                        <p>Saison {{ saison.collection.saison }} — {{ saison.collection.nom }}</p>
                        <p>{{ saison.possedes }} / {{ saison.total }} Stickman(s)</p>
                    {% else %}
                        <p>Aucune saison active.</p>
                    {% endif %}
                    <a href="{{ path('app_saison') }}">Voir la saison</a>
                </article>

                <article class="dashboard-card">
                    <h3>Combat en ligne</h3>
                    {% if tableau_de_bord.combatActif %}
                        <p>
                            Combat #{{ tableau_de_bord.combatActif.id }} —
                            {{ tableau_de_bord.combatActif.statut|replace({'_': ' '}) }}
                        </p>
                        <a href="{{ path('app_combats_en_ligne') }}">
                            Reprendre le combat
                        </a>
                    {% else %}
                        <p>Aucun combat actif.</p>
                        <a href="{{ path('app_combats_en_ligne') }}">
                            Trouver un combat
                        </a>
                    {% endif %}
                </article>

                <article class="dashboard-card">
                    <h3>Classement ELO</h3>
                    <p>{{ app.user.elo }} ELO</p>
                    <a href="{{ path('app_classement') }}">
                        Voir le classement
                    </a>
                </article>
            </div>
        </section>

        <section class="dashboard-section" aria-labelledby="raccourcis-titre">
            <h2 id="raccourcis-titre">Raccourcis</h2>
            <ul>
                <li><a href="{{ path('app_inventaire') }}">Ouvrir une caisse depuis l’inventaire</a></li>
                <li><a href="{{ path('app_wiki') }}">Consulter le wiki</a></li>
                <li><a href="{{ path('app_combats_en_ligne') }}">Accéder aux combats</a></li>
                <li><a href="{{ path('app_classement') }}">Consulter le classement ELO</a></li>
            </ul>
        </section>

        <section class="dashboard-section" aria-labelledby="derniers-combats-titre">
            <h2 id="derniers-combats-titre">Derniers combats</h2>

            {% if tableau_de_bord.derniersCombats is empty %}
                <p>Aucun combat terminé pour le moment.</p>
            {% else %}
                <ul class="dashboard-combats">
                    {% for combat in tableau_de_bord.derniersCombats %}
                        <li>
                            <strong>Combat #{{ combat.id }}</strong>
                            — {{ combat.statut|replace({'_': ' '}) }}
                            — {{ combat.numeroRound }} round(s)
                            <a href="{{ path('app_rapport_combat_en_ligne', {id: combat.id}) }}">
                                Voir le rapport
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
    {% else %}
        <section class="home-invitation"><div><span class="page-kicker">À toi de jouer</span><h2>Une collection qui te ressemble.</h2><p>Explore les raretés, lis les passifs et imagine ta première formation.</p></div><a class="button-secondary" href="{{ path('app_boutique') }}">Explorer les caisses →</a></section>
    {% endif %}
{% endblock %}
