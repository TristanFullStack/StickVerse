<form class="admin-delete-form" method="post" action="{{ path('app_caisse_delete', {'id': caisse.id}) }}" onsubmit="return confirm('Supprimer cette caisse ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ caisse.id) }}">
    <button class="admin-danger-action" type="submit">Supprimer</button>
</form>
