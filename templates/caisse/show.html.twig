{% extends 'base.html.twig' %}

{% block title %}Caisse{% endblock %}

{% block body %}
    <h1>Caisse</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ caisse.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ caisse.nom }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ caisse.slug }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ caisse.description }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ caisse.image }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ caisse.prix }}</td>
            </tr>
            <tr>
                <th>StatutActif</th>
                <td>{{ caisse.statutActif ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_caisse_index') }}">back to list</a>

    <a href="{{ path('app_caisse_edit', {'id': caisse.id}) }}">edit</a>

    {{ include('caisse/_delete_form.html.twig') }}
{% endblock %}
