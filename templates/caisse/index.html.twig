{% extends 'base.html.twig' %}

{% block title %}Caisses - Administration{% endblock %}

{% block body %}
    <div class="admin-page-heading">
        <div>
            <p class="admin-kicker">Administration / Économie</p>
            <h1>Caisses</h1>
            <p>Configure les collections, leurs prix et leur disponibilité dans la boutique.</p>
        </div>
        <a class="admin-primary-action" href="{{ path('app_caisse_new') }}">Créer une caisse</a>
    </div>

    <section class="admin-list-panel">
        <div class="admin-list-heading">
            <strong>{{ caisses|length }} caisse{% if caisses|length != 1 %}s{% endif %}</strong>
            <a href="{{ path('app_caisse_stickman_index') }}">Gérer les contenus</a>
        </div>
        <div class="admin-table-scroll">
        <table class="admin-resource-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Image</th>
                <th>Prix</th>
                <th>Contenus</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for caisse in caisses %}
            <tr>
                <td><strong>{{ caisse.nom }}</strong><small>{{ caisse.slug }}</small></td>
                <td class="admin-description-cell">{{ caisse.description }}</td>
                <td><small>{{ caisse.image }}</small></td>
                <td><strong>{{ caisse.prix }} pièces</strong></td>
                <td>{{ caisse.contenus|length }}</td>
                <td><span class="admin-status {{ caisse.statutActif ? 'admin-status--active' : 'admin-status--inactive' }}">{{ caisse.statutActif ? 'Active' : 'Inactive' }}</span></td>
                <td class="admin-table-actions">
                    <a href="{{ path('app_caisse_show', {'id': caisse.id}) }}">Détails</a>
                    <a href="{{ path('app_caisse_edit', {'id': caisse.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucune caisse enregistrée.</td>
            </tr>
        {% endfor %}
        </tbody>
        </table>
        </div>
    </section>
{% endblock %}
