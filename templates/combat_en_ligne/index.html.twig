{% extends 'base.html.twig' %}

{% block title %}Combats en ligne - StickVerse{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link
        rel="stylesheet"
        href="{{ asset('styles/combat_en_ligne.css') }}"
        data-combat-en-ligne-style
    >
{% endblock %}

{% block body %}
    <main
        id="combat-en-ligne"
        data-controller="combat-en-ligne"
        data-combat-en-ligne-salon-url-value="{{ path(
            'app_salon_combat_en_ligne_etat'
        ) }}"
        data-combat-en-ligne-creer-url-value="{{ path(
            'app_salon_combat_en_ligne_creer'
        ) }}"
        data-combat-en-ligne-matchmaking-url-value="{{ path(
            'app_salon_combat_en_ligne_rechercher_adversaire'
        ) }}"
        data-combat-en-ligne-rejoindre-url-modele-value="{{ path(
            'app_salon_combat_en_ligne_rejoindre',
            {id: '__combat_id__'}
        ) }}"
        data-combat-en-ligne-rejoindre-par-code-url-value="{{ path(
            'app_salon_combat_en_ligne_rejoindre_par_code'
        ) }}"
        data-combat-en-ligne-combat-url-modele-value="{{ path(
            'app_combat_en_ligne_etat',
            {id: '__combat_id__'}
        ) }}"
        data-combat-en-ligne-plan-url-modele-value="{{ path(
            'app_combat_en_ligne_plan',
            {id: '__combat_id__'}
        ) }}"
        data-combat-en-ligne-pret-url-modele-value="{{ path(
            'app_combat_en_ligne_pret',
            {id: '__combat_id__'}
        ) }}"
        data-combat-en-ligne-abandon-url-modele-value="{{ path(
            'app_combat_en_ligne_abandon',
            {id: '__combat_id__'}
        ) }}"
        data-combat-en-ligne-annuler-url-modele-value="{{ path(
            'app_combat_en_ligne_annuler',
            {id: '__combat_id__'}
        ) }}"
        data-combat-en-ligne-rapport-url-modele-value="{{ path(
            'app_rapport_combat_en_ligne',
            {id: '__combat_id__'}
        ) }}"
        data-combat-en-ligne-images-base-url-value="{{ asset(
            'images/stickmen'
        ) }}"
    >
        <section aria-labelledby="combat-en-ligne-titre">
            <h1 id="combat-en-ligne-titre">
                Combats en ligne
            </h1>

            <p>
                Prépare ton équipe et affronte un autre joueur.
            </p>
            <p class="combat-context-links">
                <a href="{{ path('app_classement') }}">Voir le classement</a>
                ·
                <a href="{{ path('app_equipe') }}">Gérer mes équipes</a>
            </p>

            <p
                data-combat-en-ligne-target="chargement"
                role="status"
            >
                Chargement du salon…
            </p>

            <p
                data-combat-en-ligne-target="erreur"
                role="alert"
                hidden
            ></p>

            <button
                type="button"
                class="combat-reessayer"
                data-combat-en-ligne-target="reessayerButton"
                data-action="combat-en-ligne#rafraichir"
                hidden
            >
                Réessayer
            </button>

            <p
                data-combat-en-ligne-target="information"
                role="status"
                hidden
            ></p>

            <section
                class="combat-actif"
                data-combat-en-ligne-target="combatActif"
                aria-labelledby="combat-actif-titre"
                hidden
            >
                <header class="combat-actif-entete">
                    <h2 id="combat-actif-titre">Combat actif</h2>

                    <p>
                        Combat #<strong data-combat-en-ligne-target="combatActifId"></strong>
                        · <strong data-combat-en-ligne-target="combatStatut"></strong>
                        · Round <strong data-combat-en-ligne-target="numeroRound"></strong>
                    </p>

                    <p
                        class="pression-combat"
                        data-combat-en-ligne-target="pressionAttaque"
                        hidden
                    ></p>
                </header>

                <section
                    data-combat-en-ligne-target="finCombat"
                    aria-labelledby="fin-combat-titre"
                    hidden
                >
                    <h3
                        id="fin-combat-titre"
                        data-combat-en-ligne-target="finCombatTitre"
                    ></h3>

                    <p
                        data-combat-en-ligne-target="finCombatMessage"
                    ></p>

                    <p
                        data-combat-en-ligne-target="finCombatRecompense"
                        hidden
                    ></p>

                    <div class="fin-combat-actions">
                        <a
                            data-combat-en-ligne-target="rapportFinalLink"
                            hidden
                        >
                            Voir le rapport
                        </a>

                        <button
                            type="button"
                            data-action="combat-en-ligne#retournerSalon"
                        >
                            Retour aux combats
                        </button>
                    </div>
                </section>

                <div class="attente-adversaire-actions">
                    <p data-combat-en-ligne-target="attenteAdversaire" hidden>
                        En attente d’un adversaire…
                    </p>

                    <button
                        type="button"
                        data-combat-en-ligne-target="annulerButton"
                        data-action="combat-en-ligne#annulerCombat"
                        hidden
                    >
                        Annuler la recherche
                    </button>
                </div>

                <section
                    class="invitation-combat"
                    data-combat-en-ligne-target="invitationCombat"
                    aria-labelledby="invitation-combat-titre"
                    hidden
                >
                    <h3 id="invitation-combat-titre">
                        Invite un ami
                    </h3>

                    <p data-combat-en-ligne-target="visibiliteCombat"></p>

                    <p>Partage ce code pour rejoindre directement le combat.</p>

                    <strong
                        class="invitation-combat-code"
                        data-combat-en-ligne-target="invitationCode"
                    ></strong>

                    <button
                        type="button"
                        data-action="combat-en-ligne#copierCodeInvitation"
                    >
                        Copier le code
                    </button>
                </section>

                <div
                    class="combat-arene"
                    data-combat-en-ligne-target="participants"
                >
                    <section
                        class="combat-equipe combat-equipe-moi"
                        aria-labelledby="mon-equipe-combat-titre"
                    >
                        <h3
                            id="mon-equipe-combat-titre"
                            data-combat-en-ligne-target="moiNom"
                        >
                            Ton équipe
                        </h3>

                        <div
                            data-combat-en-ligne-target="moiCombattants"
                        ></div>
                    </section>

                    <section class="combat-centre" aria-label="Commandes du round">
                        <p
                            class="combat-etat-round"
                            data-combat-en-ligne-target="etatRound"
                            role="status"
                        ></p>

                        <section
                            class="capacites-tactiques"
                            aria-label="Capacités tactiques visibles"
                            data-combat-en-ligne-target="capacitesTactiques"
                        ></section>

                        <section
                            class="preparation-combat"
                            data-combat-en-ligne-target="preparationSection"
                            aria-labelledby="preparation-combat-titre"
                            hidden
                        >
                            <h3 id="preparation-combat-titre">Préparation</h3>
                            <p
                                data-combat-en-ligne-target="preparationMessage"
                                role="status"
                            ></p>
                            <button
                                type="button"
                                data-combat-en-ligne-target="pretButton"
                                data-action="combat-en-ligne#confirmerPret"
                            >Je suis prêt</button>
                        </section>

                        <section
                            class="plan-combat"
                            data-combat-en-ligne-target="planSection"
                            aria-labelledby="plan-secret-titre"
                            hidden
                        >
                            <h3 id="plan-secret-titre">Ton plan secret</h3>

                            <form
                                data-combat-en-ligne-target="planForm"
                                data-action="submit->combat-en-ligne#soumettrePlan change->combat-en-ligne#synchroniserPlan"
                            >
                                <div class="plan-tactique">
                                    <p
                                        class="plan-tactique-instruction"
                                        data-combat-en-ligne-target="instructionPlan"
                                        role="status"
                                    >Choisis d’abord la cible de l’attaque X.</p>

                                    <div class="plan-tactique-actions">
                                        {% for cle, libelle in {
                                            cibleAttaqueX: 'Attaque X',
                                            cibleAttaqueY: 'Attaque Y',
                                            cibleDefenseX: 'Défense X',
                                            cibleDefenseY: 'Défense Y'
                                        } %}
                                            <button
                                                type="button"
                                                class="plan-tactique-action"
                                                data-plan-cle="{{ cle }}"
                                                data-combat-en-ligne-target="planActionButton"
                                                data-action="combat-en-ligne#activerChoixPlan"
                                            >
                                                <strong>{{ libelle }}</strong>
                                                <span data-plan-valeur>À choisir</span>
                                            </button>
                                        {% endfor %}
                                    </div>

                                    <p
                                        class="plan-tactique-resume"
                                        data-combat-en-ligne-target="resumePlan"
                                    >Le résumé tactique apparaîtra ici.</p>
                                </div>

                                <details class="plan-selects-secours">
                                    <summary>Listes de sélection</summary>
                                    <div class="plan-selects-grille">
                                        <fieldset>
                                            <legend>Équipe X — A + B</legend>
                                            <label for="cible-attaque-x">Cible de l’attaque</label>
                                            <select id="cible-attaque-x" required data-combat-en-ligne-target="cibleAttaqueX"></select>
                                            <label for="cible-defense-x">Cible de la défense</label>
                                            <select id="cible-defense-x" required data-combat-en-ligne-target="cibleDefenseX"></select>
                                        </fieldset>
                                        <fieldset>
                                            <legend>Équipe Y — C + D</legend>
                                            <label for="cible-attaque-y">Cible de l’attaque</label>
                                            <select id="cible-attaque-y" required data-combat-en-ligne-target="cibleAttaqueY"></select>
                                            <label for="cible-defense-y">Cible de la défense</label>
                                            <select id="cible-defense-y" required data-combat-en-ligne-target="cibleDefenseY"></select>
                                        </fieldset>
                                    </div>
                                </details>

                                <button type="submit" data-combat-en-ligne-target="envoyerPlanButton">
                                    Valider le tour
                                </button>
                            </form>
                        </section>

                        <section
                            class="resultat-round-compact"
                            data-combat-en-ligne-target="resultatRound"
                            aria-labelledby="resultat-round-titre"
                            hidden
                        >
                            <h3 id="resultat-round-titre">
                                Round <span data-combat-en-ligne-target="resultatRoundNumero"></span>
                            </h3>
                            <div class="resultat-round-tableau">
                                <table>
                                    <thead><tr><th>Cible</th><th>ATQ</th><th>DÉF</th><th>Dégâts</th><th>PV</th></tr></thead>
                                    <tbody data-combat-en-ligne-target="resultatRoundLignes"></tbody>
                                </table>
                            </div>
                        </section>
                    </section>

                    <section
                        class="combat-equipe combat-equipe-adversaire"
                        aria-labelledby="equipe-adverse-combat-titre"
                    >
                        <h3
                            id="equipe-adverse-combat-titre"
                            data-combat-en-ligne-target="adversaireNom"
                        >
                            Équipe adverse
                        </h3>

                        <div
                            data-combat-en-ligne-target="adversaireCombattants"
                        ></div>
                    </section>
                </div>

                <details
                    class="combat-historique"
                    data-combat-en-ligne-target="historiqueRounds"
                    aria-labelledby="historique-rounds-titre"
                    hidden
                >
                    <summary id="historique-rounds-titre">Rounds précédents</summary>

                    <div
                        data-combat-en-ligne-target="historiqueRoundsListe"
                    ></div>
                </details>

                <footer class="combat-actions-globales">
                    <button type="button" data-action="combat-en-ligne#retournerSalon">Retour</button>
                    <button type="button" data-action="combat-en-ligne#rafraichir">Actualiser</button>
                    <button type="button" data-combat-en-ligne-target="abandonButton" data-action="combat-en-ligne#abandonnerCombat" hidden>Abandonner</button>
                </footer>
            </section>

            <div data-combat-en-ligne-target="salon" hidden>
                <section aria-labelledby="equipe-selection-titre">
                    <h2 id="equipe-selection-titre">
                        Équipe sélectionnée
                    </h2>

                    <label for="combat-equipe">
                        Choisis ton équipe
                    </label>

                    <select
                        id="combat-equipe"
                        data-combat-en-ligne-target="equipeSelect"
                        data-action="combat-en-ligne#changerEquipe"
                    ></select>

                    <div
                        data-combat-en-ligne-target="equipeApercu"
                        aria-live="polite"
                    ></div>

                    <div class="choix-mode-combat">
                        <article>
                            <h3>Combat classé public</h3>
                            <p>
                                Le jeu cherche automatiquement l’adversaire le plus proche selon ton ELO et la puissance de ton équipe.
                            </p>
                            <button
                                type="button"
                                data-combat-en-ligne-target="rechercherButton"
                                data-action="combat-en-ligne#rechercherAdversaire"
                            >
                                Rechercher un adversaire
                            </button>
                        </article>

                        <article>
                            <h3>Combat privé</h3>
                            <p>
                                Crée un combat sans effet sur l’ELO et partage son code avec un ami.
                            </p>
                            <button
                                type="button"
                                data-combat-en-ligne-target="creerButton"
                                data-action="combat-en-ligne#creerCombatPrive"
                            >
                                Créer un combat privé
                            </button>
                        </article>
                    </div>
                </section>

                <section aria-labelledby="combat-prive-titre">
                    <h2 id="combat-prive-titre">
                        Rejoindre un combat privé
                    </h2>
                    <form
                        class="rejoindre-par-code"
                        data-action="submit->combat-en-ligne#rejoindreParCode"
                    >
                        <label for="code-invitation-combat">
                            Rejoindre avec un code
                        </label>

                        <input
                            id="code-invitation-combat"
                            type="text"
                            inputmode="text"
                            maxlength="9"
                            autocomplete="off"
                            placeholder="SV-A1B2C3"
                            data-combat-en-ligne-target="codeInvitationInput"
                            required
                        >

                        <button type="submit">
                            Rejoindre
                        </button>
                    </form>
                </section>

                <section
                    class="historique-combats-section"
                    aria-labelledby="historique-combats-titre"
                >
                    <h2 id="historique-combats-titre">
                        Mes derniers combats
                    </h2>

                    <p data-combat-en-ligne-target="aucunHistoriqueCombat">
                        Aucun combat terminé pour le moment.
                    </p>

                    <div
                        data-combat-en-ligne-target="historiqueCombats"
                        aria-live="polite"
                    ></div>
                </section>
            </div>

            <noscript>
                JavaScript doit être activé pour utiliser les combats en ligne.
            </noscript>
        </section>
    </main>
{% endblock %}
