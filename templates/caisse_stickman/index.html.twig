{% extends 'base.html.twig' %}

{% block title %}Contenu des caisses - Administration{% endblock %}

{% block body %}
    <div class="admin-page-heading">
        <div>
            <p class="admin-kicker">Administration</p>
            <h1>Contenu des caisses</h1>
            <p>Gère les Stickmen disponibles dans chaque caisse et leurs probabilités de tirage.</p>
        </div>
        <a class="admin-primary-action" href="{{ path('app_caisse_stickman_new') }}">Ajouter un Stickman à une caisse</a>
    </div>

    {% if groupes is empty %}
        <section class="admin-empty-state">
            <h2>Aucune caisse créée</h2>
            <p>Crée d’abord une caisse, puis ajoute ses Stickmen et leurs poids.</p>
            <a href="{{ path('app_caisse_new') }}">Créer une caisse</a>
        </section>
    {% else %}
        <div class="admin-caisse-groups">
            {% for groupe in groupes %}
                {% set caisse = groupe.caisse %}
                <section class="admin-caisse-group" data-admin-caisse="{{ caisse.slug }}">
                    <header class="admin-caisse-group-heading">
                        <div>
                            <h2>{{ caisse.nom }}</h2>
                            <p>{{ caisse.description }}</p>
                        </div>
                        <div class="admin-caisse-group-actions">
                            <a href="{{ path('app_caisse_show', {'id': caisse.id}) }}">Voir la caisse</a>
                            <a href="{{ path('app_caisse_edit', {'id': caisse.id}) }}">Modifier la caisse</a>
                        </div>
                    </header>

                    <dl class="admin-caisse-summary">
                        <div>
                            <dt>Prix</dt>
                            <dd>{{ caisse.prix }} pièces</dd>
                        </div>
                        <div>
                            <dt>Contenus</dt>
                            <dd>{{ groupe.contenus|length }} Stickman{% if groupe.contenus|length != 1 %}s{% endif %}</dd>
                        </div>
                        <div>
                            <dt>Poids total</dt>
                            <dd>{{ caisse.poidsTotal }}</dd>
                        </div>
                        <div>
                            <dt>Statut</dt>
                            <dd>{{ caisse.statutActif ? 'Active' : 'Inactive' }}</dd>
                        </div>
                    </dl>

                    {% if groupe.contenus is empty %}
                        <p class="admin-empty-inline">Cette caisse ne contient encore aucun Stickman.</p>
                    {% else %}
                        <div class="admin-table-scroll">
                            <table class="admin-caisse-table">
                                <thead>
                                    <tr>
                                        <th>Stickman</th>
                                        <th>Rareté</th>
                                        <th>PV</th>
                                        <th>ATQ</th>
                                        <th>DEF</th>
                                        <th>Poids</th>
                                        <th>Probabilité</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for contenu in groupe.contenus %}
                                        {% set stickman = contenu.stickman %}
                                        <tr>
                                            <td>
                                                <strong>{{ stickman ? stickman.nom : 'Stickman supprimé' }}</strong>
                                                {% if stickman %}<small>{{ stickman.slug }}</small>{% endif %}
                                            </td>
                                            <td>{{ stickman ? stickman.rarete : '-' }}</td>
                                            <td>{{ stickman ? stickman.pv : '-' }}</td>
                                            <td>{{ stickman ? stickman.attaque : '-' }}</td>
                                            <td>{{ stickman ? stickman.defense : '-' }}</td>
                                            <td><strong>{{ contenu.poids }}</strong></td>
                                            <td>{{ contenu.probabilite|round(2) }} %</td>
                                            <td class="admin-table-actions">
                                                <a href="{{ path('app_caisse_stickman_show', {'id': contenu.id}) }}">Détails</a>
                                                <a href="{{ path('app_caisse_stickman_edit', {'id': contenu.id}) }}">Modifier</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
