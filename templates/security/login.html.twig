{% extends 'base.html.twig' %}

{% block title %}Se connecter — StickVerse{% endblock %}

{% block body %}
    <main class="auth-layout auth-layout--login" aria-labelledby="connexion-titre">
        <section class="auth-card">
            <div class="auth-card-header">
                <p class="auth-eyebrow">Ravi de te revoir</p>
                <h1 id="connexion-titre">Se connecter</h1>
                <p>Retrouve tes équipes, tes combats et ta collection.</p>
            </div>

            {% for message in app.flashes('success') %}
                <div class="auth-alert auth-alert--success" role="status">{{ message }}</div>
            {% endfor %}

            {% if app.user %}
                <div class="auth-alert auth-alert--info" role="status">
                    <strong>Tu es déjà connecté avec {{ app.user.pseudo }}.</strong>
                    <span><a href="{{ path('app_profil') }}">Ouvrir ton profil</a> ou <a href="{{ path('app_logout') }}">te déconnecter</a>.</span>
                </div>
            {% else %}
                <form method="post" action="{{ path('app_login') }}" class="auth-form">
                    {% if error %}
                        <div class="auth-alert auth-alert--error" role="alert">
                            <strong>Connexion impossible</strong>
                            <span>{{ error.messageKey|trans(error.messageData, 'security', 'fr') }}</span>
                        </div>
                    {% endif %}

                    <p class="auth-form-intro">
                        Saisis l’adresse e-mail confirmée associée à ton compte.
                    </p>

                    <div class="auth-field">
                        <label for="username">Adresse e-mail</label>
                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="_username"
                            id="username"
                            autocomplete="email"
                            inputmode="email"
                            maxlength="180"
                            placeholder="toi@exemple.com"
                            required
                            autofocus
                        >
                    </div>

                    <div class="auth-field">
                        <label for="password">Mot de passe</label>
                        <input
                            type="password"
                            name="_password"
                            id="password"
                            autocomplete="current-password"
                            placeholder="Ton mot de passe"
                            required
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <button class="auth-submit" type="submit">Se connecter</button>

                    <div class="auth-form-links">
                        <a href="{{ path('app_demande_reinitialisation_mot_de_passe') }}">Mot de passe oublié ?</a>
                    </div>
                </form>
            {% endif %}

            <div class="auth-divider"><span>ou</span></div>
            <p class="auth-switch">
                Pas encore de compte ?
                <a href="{{ path('app_register') }}">Créer un compte</a>
            </p>
        </section>

        <aside class="auth-aside" aria-labelledby="connexion-aide">
            <p class="auth-aside-kicker">Un accès simple et sécurisé</p>
            <h2 id="connexion-aide">Besoin d’un coup de main ?</h2>
            <ul class="auth-benefits">
                <li><strong>Adresse confirmée</strong><small>La confirmation protège ton compte contre les erreurs d’adresse.</small></li>
                <li><strong>Mot de passe oublié</strong><small>Demande un lien de réinitialisation valable pendant une durée limitée.</small></li>
                <li><strong>E-mail non reçu</strong><small>Tu peux demander un nouvel e-mail de confirmation ci-dessous.</small></li>
            </ul>

            <details class="auth-secondary-help">
                <summary>Renvoyer l’e-mail de confirmation</summary>
                <p>Indique ton adresse. Pour protéger les comptes, la réponse reste la même qu’un compte existe ou non.</p>
                <form method="post" action="{{ path('app_verification_email_renvoyer') }}" class="auth-form auth-form--compact">
                    <div class="auth-field">
                        <label for="verification-email">Adresse e-mail</label>
                        <input
                            type="email"
                            name="email"
                            id="verification-email"
                            autocomplete="email"
                            inputmode="email"
                            placeholder="toi@exemple.com"
                            required
                        >
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('verification-email-renvoi') }}">
                    <button type="submit" class="auth-secondary-submit">Renvoyer le lien</button>
                </form>
            </details>
        </aside>
    </main>
{% endblock %}
