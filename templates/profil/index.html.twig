{% extends 'base.html.twig' %}

{% block title %}Mon profil — StickVerse{% endblock %}

{% block body %}
    <h1>Mon profil</h1>

    {% for message in app.flashes('success') %}
        <p class="alert-success" role="status">{{ message }}</p>
    {% endfor %}

    <section class="profile-section" aria-labelledby="compte-titre">
        <h2 id="compte-titre">Compte</h2>
        <dl>
            <dt>Pseudo public</dt>
            <dd data-profile-pseudo>{{ app.user.pseudo }}</dd>

            <dt>Adresse électronique</dt>
            <dd>{{ app.user.userIdentifier }}</dd>

            <dt>Solde</dt>
            <dd data-profile-pieces>{{ app.user.pieces }} pièces</dd>

            <dt>Cote ELO</dt>
            <dd data-profile-elo>{{ profil.elo }}</dd>

            <dt>Type de compte</dt>
            <dd data-profile-account-type>
                {% if is_granted('ROLE_ADMIN') %}
                    Administrateur
                {% else %}
                    Joueur
                {% endif %}
            </dd>
        </dl>
        <p><a href="{{ path('app_modifier_pseudo') }}">Modifier mon pseudo</a></p>
    </section>

    <section class="profile-section" aria-labelledby="progression-titre">
        <h2 id="progression-titre">Progression</h2>
        <ul>
            <li>{{ profil.nombreStickmen }} Stickman(s) différent(s)</li>
            <li>
                Équipe :
                {% if profil.equipe %}
                    {{ profil.equipe.nom }}
                {% else %}
                    aucune équipe enregistrée
                {% endif %}
            </li>
        </ul>
        <p>
            <a href="{{ path('app_collection') }}">Voir ma collection</a>
            <a href="{{ path('app_equipe') }}">Gérer mon équipe</a>
        </p>
    </section>

    <section class="profile-section" aria-labelledby="statistiques-titre">
        <h2 id="statistiques-titre">Statistiques des combats</h2>
        <nav class="profile-season-tabs" aria-label="Filtrer les statistiques par saison">
            <a href="{{ path('app_profil') }}"{% if saisonSelectionnee is null %} aria-current="page"{% endif %}>Toutes les saisons</a>
            {% for saison in saisonsDisponibles %}<a href="{{ path('app_profil', {saison: saison}) }}"{% if saisonSelectionnee == saison %} aria-current="page"{% endif %}>Saison {{ saison }}</a>{% endfor %}
        </nav>
        <dl class="profile-stats">
            <div data-profile-stat="total">
                <dt>Combats joués</dt>
                <dd>{{ profil.statistiques.total }}</dd>
            </div>
            <div data-profile-stat="victoires">
                <dt>Victoires</dt>
                <dd>{{ profil.statistiques.victoires }}</dd>
            </div>
            <div data-profile-stat="defaites">
                <dt>Défaites</dt>
                <dd>{{ profil.statistiques.defaites }}</dd>
            </div>
            <div data-profile-stat="matchs-nuls">
                <dt>Matchs nuls</dt>
                <dd>{{ profil.statistiques.matchsNuls }}</dd>
            </div>
        </dl>
        <p><a href="{{ path('app_combats_en_ligne') }}">Voir mes combats</a></p>
    </section>

    <section class="profile-section" aria-labelledby="securite-titre">
        <h2 id="securite-titre">Sécurité du compte</h2>
        <p><a href="{{ path('app_modifier_mot_de_passe') }}">Modifier mon mot de passe</a></p>
    </section>

    {% if false %}
    <section class="profile-section" aria-labelledby="mouvements-pieces-titre">
        <h2 id="mouvements-pieces-titre">Mouvements de pièces</h2>
        {% if profil.mouvementsPieces is empty %}
            <p data-profile-mouvements-vides>Aucun mouvement enregistré.</p>
        {% else %}
            <table data-profile-mouvements>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Opération</th>
                        <th>Montant</th>
                    </tr>
                </thead>
                <tbody>
                    {% for mouvement in profil.mouvementsPieces %}
                        <tr data-profile-mouvement>
                            <td>{{ mouvement.dateCreation|date('d/m/Y H:i') }}</td>
                            <td>{{ mouvement.libelle }}</td>
                            <td>{{ mouvement.montant > 0 ? '+' : '' }}{{ mouvement.montant }} pièces</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
    {% endif %}

    {% if false %}
    <section class="profile-section profile-rewards" aria-labelledby="recompenses-titre" data-profile-recompenses>
        <h2 id="recompenses-titre">Récompenses</h2>

        <section aria-labelledby="recompense-quotidienne-titre">
        <h2 id="recompense-quotidienne-titre">Récompense quotidienne</h2>
        <p>Récompense de connexion : {{ constant('App\\Service\\RecompenseQuotidienneService::MONTANT') }} pièces une fois par jour.</p>
        {% if profil.recompenseQuotidienneDisponible %}
            <form method="post" action="{{ path('app_recompense_quotidienne') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('recompense-quotidienne') }}">
                <button type="submit" data-profile-recompense-quotidienne>
                    Récupérer ma récompense
                </button>
            </form>
        {% else %}
            <p data-profile-recompense-indisponible>Récompense déjà récupérée aujourd’hui.</p>
        {% endif %}
        </section>

        <section aria-labelledby="recompense-horaire-titre">
            <h2 id="recompense-horaire-titre">Récompense horaire</h2>
            <p>{{ constant('App\\Service\\RecompenseHoraireService::MONTANT_PAR_HEURE') }} pièces par heure, cumulables jusqu’à {{ constant('App\\Service\\RecompenseHoraireService::MONTANT_MAXIMUM') }} pièces.</p>
            {% if profil.recompenseHoraireDisponible > 0 %}
                <p data-profile-recompense-horaire-disponible>{{ profil.recompenseHoraireDisponible }} pièces disponibles.</p>
                <form method="post" action="{{ path('app_recompense_horaire') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('recompense-horaire') }}">
                    <button type="submit" data-profile-recompense-horaire>Récupérer mes pièces</button>
                </form>
            {% else %}
                <p data-profile-recompense-horaire-indisponible>Prochaine pièce disponible dans moins d’une heure.</p>
            {% endif %}
        </section>

        <section aria-labelledby="missions-quotidiennes-titre">
            <h2 id="missions-quotidiennes-titre">Missions quotidiennes</h2>
            {% for mission in profil.missions.quotidiennes %}
                <div data-profile-mission="quotidiennes-{{ mission.id }}">
                    <strong>{{ mission.libelle }}</strong> — {{ mission.description }}
                    ({{ mission.progression }}/{{ mission.cible }}) — {{ mission.recompense }} pièces
                    {% if mission.reclame %}
                        <span data-profile-mission-reclamee>Réclamée</span>
                    {% elseif mission.disponible %}
                        <form method="post" action="{{ path('app_mission_reclamer', {periode: 'quotidiennes', mission: mission.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('mission-quotidiennes-' ~ mission.id) }}">
                            <button type="submit">Réclamer</button>
                        </form>
                    {% endif %}
                </div>
            {% else %}
                <p>Aucune mission quotidienne.</p>
            {% endfor %}
        </section>

        <section aria-labelledby="missions-hebdomadaires-titre">
            <h2 id="missions-hebdomadaires-titre">Missions hebdomadaires</h2>
            {% for mission in profil.missions.hebdomadaires %}
                <div data-profile-mission="hebdomadaires-{{ mission.id }}">
                    <strong>{{ mission.libelle }}</strong> — {{ mission.description }}
                    ({{ mission.progression }}/{{ mission.cible }}) — {{ mission.recompense }} pièces
                    {% if mission.reclame %}
                        <span data-profile-mission-reclamee>Réclamée</span>
                    {% elseif mission.disponible %}
                        <form method="post" action="{{ path('app_mission_reclamer', {periode: 'hebdomadaires', mission: mission.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('mission-hebdomadaires-' ~ mission.id) }}">
                            <button type="submit">Réclamer</button>
                        </form>
                    {% endif %}
                </div>
            {% else %}
                <p>Aucune mission hebdomadaire.</p>
            {% endfor %}
        </section>

    <section class="profile-section" aria-labelledby="objectifs-titre">
        <h2 id="objectifs-titre">Objectifs</h2>
        {% if profil.objectifs is empty %}
            <p>Aucun objectif disponible.</p>
        {% else %}
            <ul data-profile-objectifs>
                {% for objectif in profil.objectifs %}
                    <li data-profile-objectif="{{ objectif.id }}">
                        <strong>{{ objectif.libelle }}</strong>
                        — {{ objectif.description }}
                        ({{ objectif.progression }}/{{ objectif.cible }})
                        — {{ objectif.recompense }} pièces
                        {% if objectif.reclame %}
                            <span data-profile-objectif-reclame>Réclamé</span>
                        {% elseif objectif.disponible %}
                            <form method="post" action="{{ path('app_objectif_reclamer', {objectif: objectif.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('objectif-' ~ objectif.id) }}">
                                <button type="submit">Réclamer</button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
    </section>
    {% endif %}
{% endblock %}
