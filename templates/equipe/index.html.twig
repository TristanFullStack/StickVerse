{% extends 'base.html.twig' %}

{% block title %}Mes équipes - StickVerse{% endblock %}

{% block body %}
    <section class="team-builder">
        <h1>Mes équipes</h1>

        <p>
            Crée plusieurs compositions selon la puissance recherchée.
            Les Stickmans A et B forment l’équipe X, les Stickmans C et D l’équipe Y.
        </p>
        <p>
            Ton ELO actuel est de <strong>{{ app.user.elo }}</strong>.
            La puissance maximale autorisée pour tes équipes est de
            <strong>{{ limite_puissance }}</strong>.
        </p>

        {% for message in app.flashes('success') %}
            <p class="flash-success">{{ message }}</p>
        {% endfor %}

        {% if equipes is empty %}
            <p>Tu n’as encore enregistré aucune équipe.</p>
        {% else %}
            <div class="team-saved-list">
                {% for equipe in equipes %}
                    <article class="team-saved-card">
                        <header>
                            <h2>{{ equipe.nom }}</h2>
                            <strong class="team-saved-power">Puissance {{ puissances[equipe.id] }}</strong>
                        </header>

                        {% set resume = resumes[equipe.id] %}
                        <div class="team-saved-members" aria-label="Composition de {{ equipe.nom }}">
                            {% for membre in resume.slots %}
                                <article class="team-member-mini team-member-mini--rarete-{{ membre.stickman.rarete|default(1) }}">
                                    <div class="team-member-mini-heading">
                                        <span>{{ membre.slot }}</span>
                                        <strong>{{ membre.stickman.nom }}</strong>
                                    </div>
                                    <img
                                        src="{{ asset('images/stickmen/' ~ membre.stickman.image) }}"
                                        alt=""
                                    >
                                    <small>Puissance {{ membre.puissance }}</small>
                                    <small>PV {{ membre.stickman.pv }} · ATQ {{ membre.stickman.attaque }} · DÉF {{ membre.stickman.defense }}</small>
                                </article>
                            {% endfor %}
                        </div>

                        <div class="team-saved-summary">
                            <span>Équipe X : <strong>{{ resume.groupes.X.attaque }} ATQ</strong> · <strong>{{ resume.groupes.X.defense }} DÉF</strong></span>
                            <span>Équipe Y : <strong>{{ resume.groupes.Y.attaque }} ATQ</strong> · <strong>{{ resume.groupes.Y.defense }} DÉF</strong></span>
                            <span>{{ resume.total.pv }} PV au total</span>
                        </div>

                        <div class="team-saved-actions">
                            <a href="{{ path('app_equipe_modifier', {id: equipe.id}) }}">
                                Modifier
                            </a>

                            <form
                                method="post"
                                action="{{ path('app_equipe_supprimer', {id: equipe.id}) }}"
                                onsubmit="return confirm('Supprimer cette équipe ?');"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('supprimer-equipe-' ~ equipe.id) }}"
                                >
                                <button type="submit">Supprimer</button>
                            </form>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <p>
                <a href="{{ path('app_combats_en_ligne') }}">
                    Accéder aux combats en ligne
                </a>
            </p>
        {% endif %}

        <section class="team-form-panel" aria-labelledby="nouvelle-equipe-titre">
            <h2 id="nouvelle-equipe-titre">Créer une équipe</h2>

            {% if nombre_stickmen_disponibles < 4 %}
                <p class="flash-error">
                    Tu possèdes seulement {{ nombre_stickmen_disponibles }} Stickman(s) différent(s).
                    Il en faut au moins 4 pour composer une équipe.
                </p>

                <a href="{{ path('app_caisse_publique') }}">Ouvrir des caisses</a>
            {% else %}
                {% include 'equipe/_form.html.twig' with {
                    form: form,
                    button_label: 'Créer cette équipe',
                    stickmen_disponibles: stickmen_disponibles,
                    puissances_stickmen: puissances_stickmen,
                    limite_puissance: limite_puissance
                } only %}
            {% endif %}
        </section>
    </section>
{% endblock %}
