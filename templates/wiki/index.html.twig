{% extends 'base.html.twig' %}

{% block title %}Wiki des Stickmans - StickVerse{% endblock %}

{% block body %}
    <h1>Wiki des Stickmans</h1>

    {% if stickmen is empty %}
        <p>Aucun Stickman actif pour le moment.</p>
    {% else %}
        <div class="stickmen-list">

            {% for stickman in stickmen %}
                {% include 'stickman/_card.html.twig' with {
                    stickman: stickman,
                    puissance: puissances[stickman.id]|default(null),
                } only %}
            {% endfor %}

        </div>
    {% endif %}
{% endblock %}
