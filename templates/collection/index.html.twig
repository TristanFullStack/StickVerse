{% extends 'base.html.twig' %}

{% block title %}Ma collection - StickVerse{% endblock %}

{% block body %}
    <h1>Ma collection</h1>

    {% for message in app.flashes('success') %}
        <p class="flash-success" role="status">
            {{ message }}
        </p>
    {% endfor %}

    <section aria-labelledby="progression-joueur-titre">
        <h2 id="progression-joueur-titre">Tes prochaines étapes</h2>

        <ol>
            <li>
                Collection de départ :
                <strong>
                    {{ nombre_stickmen_differents }} Stickman(s) différent(s)
                </strong>
            </li>
            <li>
                {% if nombre_stickmen_differents >= 4 %}
                    <a href="{{ path('app_equipe') }}">
                        {{ equipe_prete ? 'Modifier mon équipe' : 'Composer ma première équipe' }}
                    </a>
                {% else %}
                    Obtenir au moins quatre Stickmans différents
                {% endif %}
            </li>
            <li>
                {% if equipe_prete %}
                    <a href="{{ path('app_combats_en_ligne') }}">
                        Accéder aux combats en ligne
                    </a>
                {% else %}
                    Accès au salon après la création de ton équipe
                {% endif %}
            </li>
        </ol>
    </section>

    {% if collections is not empty %}
        <section aria-labelledby="collections-titre">
            <h2 id="collections-titre">Collections</h2>

            {% for groupe in collections %}
                <section class="collection-group" aria-labelledby="collection-{{ groupe.collection.id }}-titre">
                    <div class="collection-group-heading">
                        <div>
                            <h3 id="collection-{{ groupe.collection.id }}-titre">{{ groupe.collection.nom }}</h3>
                            <p>{{ groupe.collection.description }}</p>
                        </div>
                        <strong>{{ groupe.possedes }} / {{ groupe.total }} Stickman(s) ({{ groupe.pourcentage }} %)</strong>
                    </div>

                    {% if groupe.stickmen is not empty %}
                        <div class="stickmen-list">
                            {% for stickman in groupe.stickmen %}
                                {% if groupe.inventaires[stickman.id] is defined %}
                                    {% include 'stickman/_card.html.twig' with {
                                        stickman: stickman,
                                        inventaire: groupe.inventaires[stickman.id],
                                        possede: true,
                                        puissance: groupe.puissances[stickman.id]|default(null),
                                    } only %}
                                {% else %}
                                    {% include 'stickman/_card.html.twig' with {
                                        stickman: stickman,
                                        possede: false,
                                        puissance: groupe.puissances[stickman.id]|default(null),
                                    } only %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <p>Aucun Stickman dans cette collection.</p>
                    {% endif %}
                </section>
            {% endfor %}
        </section>
    {% elseif inventaires is empty %}
        <p>Tu ne possèdes encore aucun Stickman.</p>

        <a href="{{ path('app_caisse_publique') }}">
            Voir les caisses
        </a>
    {% else %}
        <section aria-labelledby="stickmen-possedes-titre">
            <h2 id="stickmen-possedes-titre">Mes Stickmans</h2>
            <div class="stickmen-list">

            {% for inventaire in inventaires %}
                {% set stickman = inventaire.stickman %}
                {% include 'stickman/_card.html.twig' with {
                    stickman: stickman,
                    inventaire: inventaire,
                    puissance: puissances[stickman.id]|default(null),
                } only %}
            {% endfor %}

            </div>
        </section>
    {% endif %}
{% endblock %}
