{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — StickVerse{% endblock %}

{% block body %}
    <h1>Mot de passe oublié</h1>

    {% for message in app.flashes('success') %}
        <p class="alert-success" role="status">{{ message }}</p>
    {% endfor %}

    <p>
        Saisis ton adresse électronique. Si un compte correspond, un lien
        valable pendant une heure sera envoyé.
    </p>

    {{ form_start(form) }}
        {{ form_row(form.email) }}
        <button type="submit">Envoyer le lien</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
{% endblock %}
