{% extends 'base.html.twig' %}

{% block title %}Console d’administration - StickVerse{% endblock %}

{% block body %}
    <div class="admin-page-heading">
        <div>
            <p class="admin-kicker">Espace réservé</p>
            <h1>Console d’administration</h1>
            <p data-admin-console-introduction>Gère le catalogue et les opérations utiles au fonctionnement de StickVerse.</p>
        </div>
    </div>

    <section class="dashboard-section admin-tool-panel admin-console" data-admin-console>
        <div class="admin-tool-heading">
            <div>
                <h2>Console de commandes</h2>
                <p>Exécute une commande de gestion en tant qu’administrateur.</p>
            </div>
            <span class="admin-tool-tag">Admin uniquement</span>
        </div>
        <form method="post" data-admin-console-form>
            <label for="admin-commande">Commande</label>
            <input
                id="admin-commande"
                name="commande"
                value="{{ commande }}"
                placeholder="help"
                autocomplete="off"
                required
            >
            <input type="hidden" name="_token" value="{{ csrf_token('console-administration') }}">
            <button type="submit">Exécuter</button>
        </form>

        {% if resultat %}
            <pre class="admin-console-result admin-console-result--{{ resultat.statut }}" data-admin-console-result>{{ resultat.message }}</pre>
        {% endif %}

        <div class="admin-command-help">
            <strong>Commandes utiles</strong>
            <code>help</code>
            <code>give Joueur-AB12 500</code>
            <code>recherche Joueur-AB12</code>
        </div>
    </section>

    <div class="dashboard-grid admin-tool-grid">
        <section class="admin-tool-card">
            <div class="admin-tool-card-title"><span class="admin-tool-number">01</span><h2>Stickmans</h2></div>
            <p>Stickmans enregistrés : <strong>{{ nombre_stickmen }}</strong></p>
            <a href="{{ path('app_stickman_index') }}">Ouvrir le catalogue</a>
        </section>
        <section class="admin-tool-card">
            <div class="admin-tool-card-title"><span class="admin-tool-number">02</span><h2>Caisses</h2></div>
            <p>{{ nombre_caisses }} caisse{% if nombre_caisses != 1 %}s{% endif %} enregistrée{% if nombre_caisses != 1 %}s{% endif %}.</p>
            <a href="{{ path('app_caisse_index') }}">Gérer les caisses</a>
        </section>
        <section class="admin-tool-card">
            <div class="admin-tool-card-title"><span class="admin-tool-number">03</span><h2>Contenus</h2></div>
            <p>{{ nombre_contenus_caisses }} association{% if nombre_contenus_caisses != 1 %}s{% endif %} caisse / Stickman.</p>
            <a href="{{ path('app_caisse_stickman_index') }}">Gérer les contenus</a>
        </section>
        <section class="admin-tool-card">
            <div class="admin-tool-card-title"><span class="admin-tool-number">04</span><h2>Collections</h2></div>
            <p>Organise les Stickmans et les caisses par saison.</p>
            <a href="{{ path('app_collection_jeu_index') }}">Gérer les collections</a>
        </section>
        <section class="admin-tool-card">
            <div class="admin-tool-card-title"><span class="admin-tool-number">05</span><h2>Actualités</h2></div>
            <p>Rédige les annonces de saison et les nouveautés visibles par les joueurs.</p>
            <a href="{{ path('app_actualite_admin_index') }}">Gérer les actualités</a>
        </section>
        <section class="admin-tool-card">
            <div class="admin-tool-card-title"><span class="admin-tool-number">06</span><h2>Comptes</h2></div>
            <p>{{ nombre_joueurs }} joueur{% if nombre_joueurs != 1 %}s{% endif %} inscrit{% if nombre_joueurs != 1 %}s{% endif %}.</p>
            <span class="admin-tool-muted">Consultation depuis les profils.</span>
        </section>
    </div>
{% endblock %}
