{% extends 'base.html.twig' %}

{% block title %}{{ caisse.nom }} — StickVerse{% endblock %}

{% block body %}
<div data-controller="caisse-ouverture">
    <p><a href="{{ path('app_boutique') }}">← Retour à la boutique</a></p>

    <section class="catalogue-detail caisse-detail">
        <div>
            <h1>{{ caisse.nom }}</h1>
            <img class="caisse-detail-image" src="{{ asset('images/caisses/' ~ caisse.image) }}" alt="{{ caisse.nom }}">
        </div>
        <div>
            <p>{{ caisse.description }}</p>
            <p><strong>Collection :</strong> {{ caisse.collectionJeu ? caisse.collectionJeu.nom ~ ' (saison ' ~ caisse.collectionJeu.saison ~ ')' : 'Catalogue général' }}</p>
            <p><strong>Prix :</strong> {{ caisse.prix }} pièces</p>

            {% if app.user %}
                <form
                    method="post"
                    action="{{ path('app_boutique_acheter', {id: caisse.id}) }}"
                    class="caisse-buy-form"
                    data-controller="shop"
                    data-shop-balance-value="{{ app.user ? app.user.pieces : 0 }}"
                    data-action="submit->shop#confirm"
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('acheter-caisse-' ~ caisse.id) }}">
                    <label class="caisse-buy-quantity">
                        Quantité
                        <input
                            type="number"
                            name="quantite"
                            value="1"
                            min="1"
                            max="100"
                            inputmode="numeric"
                            data-shop-target="quantity"
                            data-shop-unit-price="{{ caisse.prix }}"
                            data-action="input->shop#update"
                        >
                    </label>
                    <p class="caisse-buy-total">Total : <strong data-shop-target="total">{{ caisse.prix }}</strong> pièces</p>
                    <button
                        type="submit"
                        data-shop-target="submit"
                        data-shop-enabled-label="Acheter cette caisse"
                        {% if not app.user or app.user.pieces < caisse.prix %}disabled{% endif %}
                    >{% if app.user and app.user.pieces >= caisse.prix %}Acheter cette caisse{% else %}Solde insuffisant{% endif %}</button>
                </form>
                <form class="caisse-legacy-open-form"
                    method="post"
                    action="{{ path('app_caisse_ouvrir', {'id': caisse.id}) }}"
                    data-action="submit->caisse-ouverture#ouvrir"
                    data-caisse-ouverture-target="form"
                    data-caisse-id="{{ caisse.id }}"
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('ouvrir' ~ caisse.id) }}">
                    <input type="hidden" name="_ouverture" value="{{ jeton_ouverture }}">
                    <button
                        type="submit"
                        data-opening-submit
                        data-action="click->caisse-ouverture#ouvrir"
                        {% if app.user.pieces < caisse.prix %}disabled{% endif %}
                    >
                        Ouvrir
                    </button>
                </form>
            {% else %}
                <p><a href="{{ path('app_login') }}">Connecte-toi pour ouvrir cette caisse</a></p>
            {% endif %}
        </div>
    </section>

    <div class="crate-opening-page-error" data-caisse-ouverture-target="pageError" role="alert" hidden></div>

    <section class="profile-section">
        <h2>Stickmans obtenables</h2>
        <p>Chaque ouverture sélectionne un Stickman selon ces probabilités.</p>
        <div class="caisse-contents-list">
            {% for contenu in contenus %}
                <article class="caisse-content-row">
                    <a href="{{ path('app_wiki_show', {slug: contenu.stickman.slug}) }}">
                        <img src="{{ asset('images/stickmen/' ~ contenu.stickman.image) }}" alt="{{ contenu.stickman.nom }}">
                    </a>
                    <div>
                        <h3><a href="{{ path('app_wiki_show', {slug: contenu.stickman.slug}) }}">{{ contenu.stickman.nom }}</a></h3>
                        <p>Probabilité : {{ contenu.probabilite|number_format(2, ',', ' ') }} %</p>
                    </div>
                </article>
            {% else %}
                <p>Cette caisse est vide.</p>
            {% endfor %}
        </div>
    </section>

    {% if app.user %}
        {% include 'caisse_publique/_ouverture_overlay.html.twig' %}
    {% endif %}
</div>
{% endblock %}
